# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Order emails (Gmail: turn on 2-step verification, then create an "App password")
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=goodnoura6@gmail.com
SMTP_PASS=your-16-letter-app-password
EMAIL_FROM=Good Noura <goodnoura6@gmail.com>
# Inbox that gets new-order emails
ADMIN_EMAIL=goodnoura6@gmail.com
# Email used to sign in to /admin (default admin@goodnoura.com)
ADMIN_LOGIN_EMAIL=admin@goodnoura.com

# Insta World courier: API key from your Insta World account
INSTAWORLD_API_KEY=your-insta-world-api-key
